//=============================================================================
// Player starts and map flow
//=============================================================================

@BaseClass base(Appearflags, Angle) size(-16 -16 -24, 16 16 32) color(0 255 0)
	model({ "path": ":progs/player.mdl" }) = PlayerClass []

@PointClass base(PlayerClass) = info_player_start : "Single-player start. KTX spawns players at " +
	"info_player_deathmatch, so this is only used when a map is played outside deathmatch." []

@PointClass base(PlayerClass) = info_player_start2 : "Return point used when the player comes " +
	"back to the start map after finishing an episode. Unused in deathmatch." []

@PointClass base(PlayerClass) = info_player_coop : "Cooperative start. Unused in deathmatch." []

@PointClass base(PlayerClass, Targetname) = info_player_deathmatch : "Deathmatch spawn point. " +
	"KTX places players at these, choosing between them by how dangerous each one is at the " +
	"moment of spawning.

KTX drops each spawn point to the floor when the map loads, which corrects spawns left " +
	"floating above the ground. A spawn that would fall more than 64 units is left where the " +
	"mapper put it, so intentionally raised spawns are preserved.

The spawn keys below equip a player spawning here, which HoonyMode uses to set up a round. " +
	"They have no effect in ordinary deathmatch."
[
	spawn_items(flags) =
	[
		1 : "HoonyMode: Shotgun" : 0
		2 : "HoonyMode: Super shotgun" : 0
		4 : "HoonyMode: Nailgun" : 0
		8 : "HoonyMode: Super nailgun" : 0
		16 : "HoonyMode: Grenade launcher" : 0
		32 : "HoonyMode: Rocket launcher" : 0
		64 : "HoonyMode: Thunderbolt" : 0
		8192 : "HoonyMode: Green armour" : 0
		16384 : "HoonyMode: Yellow armour" : 0
		32768 : "HoonyMode: Red armour" : 0
		131072 : "HoonyMode: Silver key" : 0
		262144 : "HoonyMode: Gold key" : 0
		524288 : "HoonyMode: Ring of shadows" : 0
		1048576 : "HoonyMode: Pentagram of protection" : 0
		2097152 : "HoonyMode: Biosuit" : 0
		4194304 : "HoonyMode: Quad damage" : 0
	]
	spawn_armorvalue(integer) : "Spawn Armour Points" : : "HOONYMODE: armour points a player has " +
		"on spawning here. Set the armour type in the spawn items as well, or the points have no " +
		"armour to belong to."
	spawn_ammo_shells(integer) : "Spawn Shells" : : "HOONYMODE: shells a player has on spawning " +
		"here."
	spawn_ammo_nails(integer) : "Spawn Nails" : : "HOONYMODE: nails a player has on spawning here."
	spawn_ammo_rockets(integer) : "Spawn Rockets" : : "HOONYMODE: rockets a player has on " +
		"spawning here."
	spawn_ammo_cells(integer) : "Spawn Cells" : : "HOONYMODE: cells a player has on spawning here."
	spawn_initial_delay(float) : "Spawn Freeze Time" : : "HOONYMODE: how long in seconds a player " +
		"spawning here is held in place before being allowed to move."
]

@PointClass base(Appearflags) size(-16 -16 -16, 16 16 16) color(255 128 128) =
	info_intermission : "Camera position shown between maps and after a match. Several may be " +
	"placed, and the game picks between them."
[
	mangle(string) : "Camera Angles" : "0 0 0" : "Direction the camera looks, as " +
		"'pitch yaw roll'. Negative pitch looks upward. This entity uses mangle rather than " +
		"angle so that the camera can be tilted as well as turned."
]

@SolidClass base(Appearflags, Target, Targetname) = trigger_changelevel : "Sends every player to " +
	"another map on touch."
[
	map(string) : "Next Map" : : "File name of the map to load, without the .bsp extension."
	spawnflags(flags) =
	[
		1 : "No intermission" : 0 : "Changes map immediately instead of showing the intermission " +
			"camera first."
	]
]


