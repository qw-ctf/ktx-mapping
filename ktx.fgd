//=============================================================================
//
// ktx.fgd - entity definitions for KTX QuakeWorld mapping in TrenchBroom
//
// Covers the entities and keys of three separate systems:
//
//   KTX          the QuakeWorld server mod that runs the map.
//                https://github.com/QW-Group/ktx
//   ericw-tools  the qbsp/light/vis compiler suite that builds the map.
//                https://github.com/ericwa/ericw-tools
//   engine       keys read by the client at runtime, not by KTX or the
//                compilers. Support varies between engines.
//
// Verified against KTX e6a722f and ericw-tools 2.0.0-alpha11.
// Targets current TrenchBroom.
//
//-----------------------------------------------------------------------------
// Reading the descriptions
//-----------------------------------------------------------------------------
//
// Descriptions open with a tag when a key applies to only one system or only
// one game mode:
//
//   COMPILER (qbsp)   Read by qbsp. Changing it requires a full recompile.
//   COMPILER (light)  Read by light. Changing it requires only a relight
//                     (qbsp -onlyents followed by light).
//   COMPILER (vis)    Read by vis.
//   ENGINE            Read by the client engine, not by KTX or the compilers.
//   KTX               Behavior specific to KTX; not present in stock Quake.
//   CTF, RACE,        Applies only while that game mode is active.
//   HOONYMODE,
//   BLOODFEST
//   Q2 ONLY           Applies only when compiling for Quake II.
//   REQUIRED          The map fails to load or compile without this key.
//   BROKEN            Known not to work in the current version.
//   DEPRECATED        Superseded; retained for compatibility.
//
// Compiler keys may be written with or without a leading underscore: light
// strips one leading underscore before matching, so "_dirt" and "dirt" are the
// same key. The underscored spelling is used throughout this file, and is the
// spelling to prefer. This applies to light only; qbsp and vis match their keys
// exactly as written.
//
// Every option on the light command line is also accepted as a worldspawn key.
// Keys named after a command-line option are grouped at the end of worldspawn.
// qbsp and vis do not work this way.
//
// KTX ignores keys it does not know and prints "unknown field: <key>" to the
// server console once per entity, so this file deliberately exposes no key
// that KTX cannot read. Compiler keys are stripped from the BSP by qbsp and
// never reach the server.
//
//-----------------------------------------------------------------------------
// House style for edits to this file
//-----------------------------------------------------------------------------
//
//   Class keywords are @BaseClass, @PointClass and @SolidClass. Property type
//   names are lowercase. The spawnflags key is always lowercase, which is what
//   lets TrenchBroom merge flag bits from several base classes.
//
//   Indentation is tabs. Property lines read
//       key(type) : "Display Name" : default : "Description."
//   with a single space around each colon. A choices property always carries
//   an explicit default, because an empty default column directly before the
//   option list is a parse error.
//
//   Descriptions are complete sentences in the present tense, stating units
//   where they apply. Flag and choice captions are sentence case. Long text is
//   split across source lines with the string continuation operator (+).
//
//=============================================================================


//=============================================================================
// Worldspawn
//=============================================================================

@BaseClass = WorldEngine [
	_sky(string) : "Skybox Name" : : "ENGINE: base name of a skybox in gfx/env/. " +
		"The engine appends the six side suffixes, so 'sky1' loads sky1rt, sky1lf and so on."
	_fog(string) : "Fog" : : "ENGINE: fog as 'density red green blue', with colour components " +
		"in the range 0 to 1. Example: '0.025 0.15 0.17 0.1' is a thin olive haze."
	_fog_density(float) : "Fog Density" : : "ENGINE: fog density on its own, for engines that " +
		"take density and colour separately. Small values are subtle; 0.025 is already visible."
	_fog_color(color255) : "Fog Colour" : : "ENGINE: fog colour on its own, for engines that " +
		"take density and colour separately."
	_skyfog(float) : "Sky Fog Density" : "0.0" : "ENGINE: how strongly fog is applied to sky " +
		"surfaces. 0 leaves the sky clear of fog."
	_wateralpha(float) : "Water Opacity" : "1.0" : "ENGINE: opacity of water surfaces, from " +
		"0.0 for invisible to 1.0 for opaque. Values below 1.0 let the player see through the surface."
	_slimealpha(float) : "Slime Opacity" : "1.0" : "ENGINE: opacity of slime surfaces, from " +
		"0.0 for invisible to 1.0 for opaque."
	_lavaalpha(float) : "Lava Opacity" : "1.0" : "ENGINE: opacity of lava surfaces, from " +
		"0.0 for invisible to 1.0 for opaque."
	_telealpha(float) : "Teleporter Opacity" : "1.0" : "ENGINE: opacity of teleporter surfaces, " +
		"from 0.0 for invisible to 1.0 for opaque."
]

@BaseClass = WorldKtx [
	hoony_timelimit(integer) : "HoonyMode Round Limit" : 0 : "KTX: length of a HoonyMode round " +
		"in seconds. Any non-zero value switches the server into HoonyMode when the map loads."
	hoony_defaultwinner(string) : "HoonyMode Default Winner" : : "KTX: targetname of a spawn " +
		"point. The player who spawned there wins a round that reaches the time limit undecided. " +
		"Setting this switches the server into HoonyMode when the map loads."
]

@BaseClass = WorldLightCore [
	_minlight(float) : "Minimum Light" : "0" : "COMPILER (light): light level applied to every " +
		"surface in the map, so that nothing is fully black. Alias: 'light'."
	_minlight_color(color255) : "Minimum Light Colour" : "255 255 255" : "COMPILER (light): " +
		"colour of the minimum light. Alias: '_mincolor'."
	_minlight_dirt(choices) : "Minimum Light Ambient Occlusion" : 0 : "COMPILER (light): whether " +
		"ambient occlusion darkens the minimum light. Forced on when '_dirt' is enabled." =
	[
		-1 : "Never occlude minimum light"
		0 : "Follow the '_dirt' setting"
		1 : "Occlude minimum light"
	]
	_minlight_mottle(choices) : "Minimum Light Mottling" : 0 : "COMPILER (light): breaks up the " +
		"flatness of minimum light with a subtle noise pattern. Alias: '_minlightMottle'." =
	[
		0 : "Flat"
		1 : "Mottled"
	]
	_maxlight(float) : "Maximum Light" : "0" : "COMPILER (light): clamps every surface to at most " +
		"this light level. 0 disables the clamp."
	_addmin(choices) : "Minimum Light Mode" : 0 : "COMPILER (light): how minimum light combines " +
		"with real lighting." =
	[
		0 : "Clamp - raise dark surfaces up to the minimum"
		1 : "Add - add the minimum on top of all lighting"
	]
	_dist(float) : "Global Fade Distance Scale" : "1.0" : "COMPILER (light): scales how far every " +
		"light reaches. Values above 1.0 make lights fade out sooner, values below 1.0 make them " +
		"carry further. Range 0 to 100."
	_range(float) : "Global Brightness Scale" : "0.5" : "COMPILER (light): scales the brightness " +
		"of every light without changing how far it reaches. Range 0 to 100."
	_gamma(float) : "Lightmap Gamma" : "1.0" : "COMPILER (light): gamma applied to the finished " +
		"lightmap. Values below 1.0 darken the map overall. Range 0 to 100."
	_anglescale(float) : "Global Angle Falloff" : "0.5" : "COMPILER (light): how much the angle " +
		"between a surface and a light affects its brightness. 0 lights every surface equally " +
		"regardless of facing; 1 is full realistic falloff. Range 0 to 1."
	_spotlightautofalloff(choices) : "Spotlight Automatic Falloff" : 0 : "COMPILER (light): " +
		"derives the fade distance of every spotlight from the distance to its target." =
	[
		0 : "Use the normal falloff rules"
		1 : "Fade out at the spotlight target"
	]
	_phong(choices) : "Phong Shading" : 1 : "Smooth shading across adjacent faces. This key is " +
		"read by both compilers and means something different to each: setting it to 0 switches " +
		"phong shading off for the whole map in light, while setting it to 1 makes qbsp turn " +
		"phong shading on for every world face." =
	[
		0 : "Disable phong shading map-wide"
		1 : "Enable phong shading on all world faces"
	]
	_phong_angle(float) : "Phong Smoothing Angle" : "0" : "COMPILER (qbsp): default smoothing " +
		"angle in degrees for every world face. Faces meeting at this angle or less are smoothed " +
		"together. Enabling '_phong' without an angle uses 89."
]

@BaseClass = WorldLightSun [
	_sunlight(float) : "Sun Brightness" : "0" : "COMPILER (light): brightness of the sun, which " +
		"casts parallel light from every sky surface. Negative values remove light. " +
		"Alias: '_sun_light'."
	_sunlight_color(color255) : "Sun Colour" : "255 255 255" : "COMPILER (light): colour of the " +
		"sun. Alias: '_sun_color'."
	_sunlight_mangle(string) : "Sun Direction" : "0 -90 0" : "COMPILER (light): direction the " +
		"sun shines, as 'yaw pitch roll'. '0 -90 0' points straight down. " +
		"Aliases: '_sun_mangle', '_sun_angle'."
	_sunlight_penumbra(float) : "Sun Edge Softness" : "0" : "COMPILER (light): width of the soft " +
		"edge on sun shadows, in degrees. 3 to 4 gives a gently softened edge; 10 to 20 gives " +
		"diffuse, overcast sunlight. Range 0 to 180."
	_sunlight_dirt(choices) : "Sun Ambient Occlusion" : 0 : "COMPILER (light): whether ambient " +
		"occlusion darkens sunlight." =
	[
		-1 : "Never occlude sunlight"
		0 : "Follow the '_dirt' setting"
		1 : "Occlude sunlight"
	]
	_sun2(float) : "Second Sun Brightness" : "0" : "COMPILER (light): brightness of a second sun, " +
		"aimed independently of the first. Useful as a fill light from another direction."
	_sun2_color(color255) : "Second Sun Colour" : "255 255 255" : "COMPILER (light): colour of " +
		"the second sun."
	_sun2_mangle(string) : "Second Sun Direction" : "0 -90 0" : "COMPILER (light): direction the " +
		"second sun shines, as 'yaw pitch roll'."
	_sunlight2(float) : "Sky Dome Brightness" : "0" : "COMPILER (light): brightness of a dome of " +
		"lights arranged above the horizon, emitting from sky surfaces. Produces soft daylight " +
		"from the whole sky rather than a single direction."
	_sunlight2_color(color255) : "Sky Dome Colour" : "255 255 255" : "COMPILER (light): colour of " +
		"the upper sky dome. Alias: '_sunlight_color2'."
	_sunlight3(float) : "Ground Dome Brightness" : "0" : "COMPILER (light): brightness of a dome " +
		"of lights arranged below the horizon, emitting from sky surfaces. Acts as bounce light " +
		"coming up off the ground."
	_sunlight3_color(color255) : "Ground Dome Colour" : "255 255 255" : "COMPILER (light): colour " +
		"of the lower dome. Alias: '_sunlight_color3'."
	_sunlight2_dirt(choices) : "Sky Dome Ambient Occlusion" : 0 : "COMPILER (light): whether " +
		"ambient occlusion darkens the sky and ground domes." =
	[
		-1 : "Never occlude the domes"
		0 : "Follow the '_dirt' setting"
		1 : "Occlude the domes"
	]
	_sunsamples(integer) : "Sky Dome Sample Count" : 64 : "COMPILER (light): how many lights make " +
		"up each dome. Higher values give smoother sky shadows and slower compiles. " +
		"Range 8 to 2048."
	_sky_surface(color255) : "Sky Surface Emission" : "0 0 0" : "COMPILER (light): makes sky " +
		"surfaces themselves emit light of this colour, in the manner of ArghRad. " +
		"Alias: '_sun_surface'."
]

@BaseClass = WorldLightDirt [
	_dirt(choices) : "Ambient Occlusion" : 0 : "COMPILER (light): darkens corners and creases " +
		"across the whole map, approximating the way light fails to reach tight spaces. " +
		"Individual lights and brush entities can opt out. Alias: '_dirty'." =
	[
		0 : "Off"
		1 : "On"
	]
	_dirtmode(choices) : "Ambient Occlusion Sampling" : 0 : "COMPILER (light): how occlusion rays " +
		"are distributed." =
	[
		0 : "Ordered - even coverage"
		1 : "Randomized - better on complex geometry"
	]
	_dirtdepth(float) : "Ambient Occlusion Depth" : "128" : "COMPILER (light): how far occlusion " +
		"rays travel, in units. Larger values spread shading further from corners."
	_dirtscale(float) : "Ambient Occlusion Strength" : "1.0" : "COMPILER (light): multiplies how " +
		"dark the occlusion shading becomes. Range 0 to 100."
	_dirtgain(float) : "Ambient Occlusion Falloff" : "1.0" : "COMPILER (light): exponent applied " +
		"to the occlusion curve. Values below 1.0 push the shading further out from corners; " +
		"values above 1.0 keep it tight. Range 0 to 100."
	_dirtangle(float) : "Ambient Occlusion Cone Angle" : "88" : "COMPILER (light): width of the " +
		"cone sampled for occlusion, in degrees. Lowering it avoids unwanted shading inside " +
		"arches and pipes. Range 1 to 90."
]

@BaseClass = WorldLightBounce [
	_bounce(integer) : "Bounce Light Passes" : 0 : "COMPILER (light): number of times light " +
		"bounces off surfaces to light other surfaces. Each pass costs compile time. " +
		"Range 0 to 100."
	_bouncescale(float) : "Bounce Light Brightness" : "1.0" : "COMPILER (light): scales the " +
		"brightness of bounced light. Range 0 to 100."
	_bouncecolorscale(float) : "Bounce Light Colour Bleed" : "0.0" : "COMPILER (light): how much " +
		"of a surface texture's colour is carried into the light it bounces. 0 bounces white " +
		"light, 1 bounces fully tinted light. Range 0 to 1."
	_bouncestyled(choices) : "Bounce Styled Lights" : 0 : "COMPILER (light): whether switchable " +
		"and animated lights contribute bounce light. They bounce at full brightness regardless " +
		"of their current state, so this is usually left off." =
	[
		0 : "Styled lights do not bounce"
		1 : "Styled lights bounce"
	]
	_bouncelightsubdivision(float) : "Bounce Emitter Size" : "64.0" : "COMPILER (light): size in " +
		"units of the patches a surface is divided into when it re-emits bounced light. Smaller " +
		"values are more accurate and slower. Range 1 to 8192."
]

@BaseClass = WorldLightSurface [
	_surflight_radiosity(choices) : "Surface Light Method" : 0 : "COMPILER (light): which " +
		"algorithm turns emissive surfaces into light." =
	[
		0 : "Subdivision - place point lights over the surface"
		1 : "Radiosity - treat the surface as an area light"
	]
	_surflight_subdivide(float) : "Surface Light Spacing" : "128.0" : "COMPILER (light): spacing " +
		"in units between the point lights placed across an emissive surface in subdivision " +
		"mode. Range 1 to 2048."
	_surflightsubdivision(float) : "Radiosity Patch Size" : "16.0" : "COMPILER (light): size in " +
		"units of the patches an emissive surface is divided into in radiosity mode. " +
		"Alias: '_choplight'. Range 1 to 8192."
	_surflightscale(float) : "Surface Light Brightness" : "1.0" : "COMPILER (light): scales the " +
		"emission of all non-sky surface lights."
	_surflightskyscale(float) : "Sky Surface Light Brightness" : "1.0" : "COMPILER (light): " +
		"scales the emission of sky surface lights."
	_surflightskydist(float) : "Sky Surface Light Distance" : "0.0" : "COMPILER (light): extra " +
		"distance added when measuring how far a surface is from the sky light that reaches it, " +
		"which softens and weakens that light."
	_surflight_minlight_scale(float) : "Surface Light Self-Illumination" : "1.0" : "COMPILER " +
		"(light): scales the minimum light applied to the emissive surface itself, so a light " +
		"fixture does not render black. 0 disables it. Range 0 to 510."
	_surflight_atten(float) : "Surface Light Attenuation" : "1.0" : "COMPILER (light): scales how " +
		"quickly surface light falls off with distance. Higher values fade it sooner."
]

@BaseClass = WorldLightGrid [
	_world_units_per_luxel(float) : "Lightmap Density" : "0" : "COMPILER (light): size in units " +
		"of one lightmap pixel, writing a DECOUPLED_LM lump so lightmap resolution is " +
		"independent of texture scale. Requires an engine that supports the lump. 0 disables it. " +
		"Range 0 to 1024."
	_lightmap_scale(integer) : "Forced Lightmap Scale" : 0 : "COMPILER (light): forces every " +
		"surface to this lightmap scale. Quake's own scale is 16, and vanilla engines accept " +
		"nothing else. 0 leaves the scale alone."
	_lmshift(integer) : "Lightmap Shift" : 4 : "COMPILER (light): applies a lightmap shift to the " +
		"whole map and writes an LMSHIFT lump, allowing a map to be relit at higher lightmap " +
		"resolution without recompiling from the source."
	_facestyles(integer) : "Light Styles Per Face" : 4 : "COMPILER (light): maximum number of " +
		"animated or switchable light styles that may affect a single face. Values above 4 " +
		"require a BSPX lump and an engine that reads it."
	_compilerstyle_start(integer) : "First Compiler Light Style" : 32 : "COMPILER (light): first " +
		"style number the compiler hands out to switchable lights. Raise it if the mod already " +
		"uses styles in this range."
	_compilerstyle_max(integer) : "Last Compiler Light Style" : 64 : "COMPILER (light): one past " +
		"the last style number available to switchable lights. Compilation fails once the " +
		"compiler runs out of style numbers."
	_lightgrid(choices) : "Light Grid" : 0 : "COMPILER (light): computes a grid of lighting " +
		"samples through the map volume and stores it in a BSPX lump, so that models and " +
		"particles can be lit by it. Requires engine support." =
	[
		0 : "Off"
		1 : "On"
	]
	_lightgrid_dist(string) : "Light Grid Spacing" : "32 32 32" : "COMPILER (light): spacing " +
		"between light grid sample points in units, as 'x y z'. Closer spacing gives better " +
		"model lighting and a larger lump."
	_lightgrid_format(choices) : "Light Grid Format" : "octree" : "COMPILER (light): which BSPX " +
		"lump the light grid is written to." =
	[
		"octree" : "LIGHTGRID_OCTREE"
		"lightgrids" : "LIGHTGRIDS"
	]
	_novanilla(choices) : "Omit Vanilla Lightmap" : 0 : "COMPILER (light): writes only the " +
		"coloured BSPX lighting and omits the plain lightmap vanilla engines read. Such a map " +
		"appears fullbright in engines without BSPX support." =
	[
		0 : "Write the vanilla lightmap"
		1 : "Omit the vanilla lightmap"
	]
]

@BaseClass = WorldLightProcess [
	_extra(integer) : "Supersampling" : 1 : "COMPILER (light): samples each lightmap pixel " +
		"several times and averages the result, softening stair-stepping along shadow edges. " +
		"2 samples a 2x2 grid, 4 samples a 4x4 grid."
	_soft(integer) : "Lightmap Blur" : 0 : "COMPILER (light): blurs the finished lightmap by this " +
		"radius in samples. -1 chooses a radius from the supersampling setting."
	_gate(float) : "Light Cutoff" : "0.001" : "COMPILER (light): brightness below which a light " +
		"stops being traced. Raising it speeds up compilation at the cost of very faint light."
	_emissivequality(choices) : "Surface Light Quality" : "LOW" : "COMPILER (light): how many " +
		"points on an emissive surface are sampled when lighting another surface." =
	[
		"LOW" : "One point at the centre of the face"
		"MEDIUM" : "Centre plus every vertex"
		"HIGH" : "Points spread out for antialiasing"
	]
	_visapprox(choices) : "Visibility Culling" : "auto" : "COMPILER (light): how light decides " +
		"that a light cannot possibly reach a face." =
	[
		"auto" : "Choose from the BSP format"
		"none" : "No culling - slowest and exact"
		"vis" : "Use BSP visibility data - slow and precise"
		"rays" : "Sphere culling with test rays - fast, may miss faces"
	]
	_tex_saturation_boost(float) : "Bounce Saturation Boost" : "0.0" : "COMPILER (light): " +
		"increases the saturation of texture colours used for bounce light, reproducing the look " +
		"of the original Quake II tools. Range 0 to 1."
	_nolights(choices) : "Ignore Light Entities" : 0 : "COMPILER (light): compiles using only " +
		"sunlight and minimum light, ignoring every light entity in the map." =
	[
		0 : "Use light entities"
		1 : "Ignore light entities"
	]
	_litonly(choices) : "Write Only Colour Data" : 0 : "COMPILER (light): writes the .lit file " +
		"and leaves the BSP untouched." =
	[
		0 : "Update the BSP"
		1 : "Write only the .lit file"
	]
	_wrnormals(choices) : "Write Normals Lump" : 0 : "COMPILER (light): stores per-vertex " +
		"normals, tangents and bitangents in a BSPX lump for engines that use them." =
	[
		0 : "Off"
		1 : "On"
	]
	_arghradcompat(choices) : "ArghRad Compatibility" : 0 : "COMPILER (light): interprets " +
		"ArghRad-specific keys in the map the way ArghRad did." =
	[
		0 : "Off"
		1 : "On"
	]
]

@SolidClass base(WorldEngine, WorldKtx, WorldLightCore, WorldLightSun, WorldLightDirt,
	WorldLightBounce, WorldLightSurface, WorldLightGrid, WorldLightProcess) =
	worldspawn : "The map itself. Every brush that does not belong to a brush entity is part of " +
	"worldspawn, and the keys here configure the map as a whole: the compilers read their " +
	"settings from it, and the server reads the game rules from it."
[
	message(string) : "Map Title" : : "Name of the map, displayed by some engines on entry. " +
		"KTX does not read this key, but it is conventional to set it. A \b character toggles " +
		"red text for the characters that follow."
	worldtype(choices) : "Theme" : 0 : "Selects which set of door sounds, key models and key " +
		"names the map uses." =
	[
		0 : "Medieval - silver and gold keys"
		1 : "Runic - runekeys"
		2 : "Base - keycards"
	]
	sounds(integer) : "CD Track" : 0 : "Music track to play. KTX does not read this key; modern " +
		"clients choose music themselves."
	wad(string) : "Texture WADs" : : "COMPILER (qbsp): semicolon-separated list of .wad files " +
		"holding the textures this map uses. TrenchBroom maintains this key itself."
]


//=============================================================================
// Shared base classes
//=============================================================================

@BaseClass = Appearflags [
	spawnflags(flags) =
	[
		256 : "Not on easy" : 0 : "Removed when the server is running skill 0. Skill filtering " +
			"is skipped entirely in deathmatch."
		512 : "Not on normal" : 0 : "Removed when the server is running skill 1. Skill filtering " +
			"is skipped entirely in deathmatch."
		1024 : "Not on hard" : 0 : "Removed when the server is running skill 2 or 3. Skill " +
			"filtering is skipped entirely in deathmatch."
		2048 : "Not in deathmatch" : 0 : "Removed when the server is running deathmatch, which " +
			"on a KTX server is nearly always the case."
	]
]

@BaseClass = Targetname [
	targetname(target_source) : "Name" : : "Name other entities use to refer to this one. An " +
		"entity is triggered when something fires at its name."
]

@BaseClass = Target [
	target(target_destination) : "Target" : : "Name of the entity to trigger."
	killtarget(target_destination) : "Kill Target" : : "Name of an entity to remove from the map " +
		"when this entity fires. The removed entity is gone for the rest of the map."
]

@BaseClass = Angle [
	angle(integer) : "Direction" : 0 : "Direction the entity faces or moves, in degrees " +
		"counter-clockwise from east. Use -1 for straight up and -2 for straight down."
]

@BaseClass = Alpha [
	alpha(float) : "Opacity" : "1.0" : "Transparency of this brush model, from 0.0 for invisible " +
		"to 1.0 for opaque. Requires an engine that supports entity alpha. light also reads this " +
		"key, and tints the shadow the model casts to match."
]

@BaseClass = Race [
	race_flags(flags) =
	[
		1 : "Race: touching fails the run" : 0 : "RACE: a racer who touches this entity fails " +
			"the current run."
		2 : "Race: touching ends the run" : 0 : "RACE: a racer who touches this entity finishes " +
			"the current run."
		4 : "Race: survives route cleanup" : 0 : "RACE: keeps this entity in the map when race " +
			"mode removes entities that are not part of the route."
	]
]


//=============================================================================
// Compiler brush keys
//
// These keys are read while the map is compiled and are stripped from the
// finished BSP, so the server never sees them.
//
// They come in two groups. BrushCompiler keys are baked into the surfaces by
// qbsp and work on any brush entity, including the detail and group entities
// whose brushes are merged into the world. BrushModel keys are read by light
// from the entity itself, and therefore only work on entities that survive
// compilation as their own brush model.
//=============================================================================

@BaseClass = BrushCompiler [
	_minlight(float) : "Minimum Light" : : "COMPILER: light level applied to every face of this " +
		"entity, so that no part of it is fully black. -1 excludes the entity from the map-wide " +
		"minimum light instead."
	_minlight_color(color255) : "Minimum Light Colour" : : "COMPILER: colour of this entity's " +
		"minimum light. Alias: '_mincolor'."
	_minlight_exclude(string) : "Minimum Light Exclusion" : : "COMPILER (qbsp): name of a texture " +
		"that is exempt from minimum light on this entity. Nine further exclusions may be added " +
		"as '_minlight_exclude2' through '_minlight_exclude9'."
	_maxlight(float) : "Maximum Light" : : "COMPILER: clamps every face of this entity to at most " +
		"this light level. Range 0 to 510."
	_lightcolorscale(float) : "Light Saturation" : "1.0" : "COMPILER: how much colour the lighting " +
		"on this entity keeps. 1.0 is full colour and 0.0 renders it in greyscale. Range 0 to 1."
	_lightignore(choices) : "Ignore Lighting" : 0 : "COMPILER: makes this entity ignore all real " +
		"lighting and take only its minimum light, giving it a flat unlit appearance." =
	[
		0 : "Receive all lighting"
		1 : "Receive only minimum light"
	]
	_shadow(choices) : "Shadow Casting" : 0 : "COMPILER: whether this entity casts shadows." =
	[
		-1 : "Cast no shadows at all"
		0 : "Default for this entity type"
		1 : "Cast shadows on the world, itself and other brush models"
	]
	_dirt(choices) : "Ambient Occlusion" : 0 : "COMPILER: whether the map-wide ambient occlusion " +
		"applies to this entity." =
	[
		-1 : "Never occlude this entity"
		0 : "Follow the worldspawn '_dirt' setting"
		1 : "Occlude this entity"
	]
	_bounce(choices) : "Bounce Light Emission" : 0 : "COMPILER: whether light bounces off this " +
		"entity onto its surroundings." =
	[
		-1 : "This entity emits no bounce light"
		0 : "Follow the worldspawn '_bounce' setting"
	]
	_phong(choices) : "Phong Shading" : 0 : "COMPILER: smooths lighting across adjacent faces of " +
		"this entity, so that a faceted curve is lit as a smooth one. Enabling it without an " +
		"angle uses 89 degrees." =
	[
		0 : "Off"
		1 : "On"
	]
	_phong_angle(float) : "Phong Smoothing Angle" : : "COMPILER: faces meeting at this angle or " +
		"less are smoothed together. Setting it enables phong shading on this entity."
	_phong_angle_concave(float) : "Phong Angle (Concave Joints)" : : "COMPILER (qbsp): separate " +
		"smoothing angle used where two faces meet in a concave joint, letting outside curves " +
		"smooth while inside corners stay sharp."
	_phong_group(integer) : "Phong Group" : 0 : "COMPILER (qbsp): faces are only smoothed against " +
		"other faces carrying the same group number. Use it to keep two surfaces that touch from " +
		"smoothing into each other."
	_light_alpha(float) : "Shadow Opacity" : : "COMPILER (qbsp): how much light this entity blocks, " +
		"from 0.0 for a shadow that is not cast at all to 1.0 for a solid shadow. Intermediate " +
		"values give the coloured, partial shadow of stained glass. Range 0 to 1."
	_light_twosided(choices) : "Two-sided Lighting" : 0 : "COMPILER (qbsp): lets faces receive " +
		"light striking them from behind. On by default for liquid surfaces." =
	[
		0 : "Light the front face only"
		1 : "Light both sides"
	]
	_object_channel_mask(integer) : "Lighting Channel Mask" : 1 : "COMPILER: bitmask of the " +
		"lighting channels this entity takes part in. A light only affects an entity that shares " +
		"one of its channels. Setting this to anything other than 1 also turns shadow casting on " +
		"and stops the entity emitting bounce light."
	_world_units_per_luxel(float) : "Lightmap Density" : : "COMPILER (qbsp): size in units of one " +
		"lightmap pixel on this entity, overriding the map-wide setting. Requires an engine that " +
		"reads the DECOUPLED_LM lump."
	_surflight_rescale(choices) : "Surface Light Rescaling" : 1 : "COMPILER (qbsp): rescales the " +
		"emission of this entity's surface lights by surface area. On by default except on sky." =
	[
		0 : "Off"
		1 : "On"
	]
	_surflight_color(color255) : "Surface Light Colour" : : "COMPILER (qbsp): overrides the colour " +
		"this entity's emissive surfaces give off, which is otherwise taken from the texture."
	_surflight_style(integer) : "Surface Light Style" : 0 : "COMPILER (qbsp): animated light style " +
		"the light from this entity's emissive surfaces uses."
	_surflight_targetname(string) : "Surface Light Switch Name" : : "COMPILER (qbsp): makes the " +
		"light from this entity's emissive surfaces switchable under this name."
	_surflight_group(integer) : "Surface Light Group" : 0 : "COMPILER (qbsp): only surface light " +
		"templates carrying the same group number make this entity's surfaces emit light."
	_surflight_minlight_scale(float) : "Surface Light Self-Illumination" : "1.0" : "COMPILER: " +
		"scales the minimum light applied to this entity's own emissive surfaces, so a light " +
		"fixture does not render black."
	_surflight_atten(float) : "Surface Light Attenuation" : "1.0" : "COMPILER: scales how quickly " +
		"the light from this entity's emissive surfaces falls off with distance."
	_mirrorinside(choices) : "Mirror Inside Faces" : 0 : "COMPILER (qbsp): generates faces looking " +
		"inward as well as outward, so the inside of the brush is drawn when the player is " +
		"inside it." =
	[
		0 : "Off"
		1 : "On"
	]
	_noclipfaces(choices) : "Keep Overlapping Faces" : 0 : "COMPILER (qbsp): keeps the faces where " +
		"this entity's brushes overlap other brushes of the same content type, instead of " +
		"clipping them away." =
	[
		0 : "Clip overlapping faces away"
		1 : "Keep overlapping faces"
	]
	_chop_order(integer) : "Face Chop Order" : 0 : "COMPILER (qbsp): controls which brush wins " +
		"where two brushes overlap and their faces have to be divided. Lower values are cut by " +
		"higher ones. Replaces the deprecated '_chop' key."
	_noambient(choices) : "Suppress Ambient Sounds" : 0 : "COMPILER (vis): stops this entity's " +
		"water, slime, lava and sky brushes contributing to the automatic ambient sounds the " +
		"engine plays." =
	[
		0 : "Contribute ambient sound"
		1 : "Silent"
	]
	_litwater(choices) : "Lit Liquid Surfaces" : 1 : "COMPILER (qbsp): subdivides this entity's " +
		"liquid surfaces so they receive lightmaps, overriding the compiler's own setting. " +
		"Alias: '_splitturb'." =
	[
		0 : "Fullbright liquids"
		1 : "Lit liquids"
	]
]

@BaseClass = BrushModel [
	_minlight_mottle(choices) : "Minimum Light Mottling" : 0 : "COMPILER (light): breaks up the " +
		"flatness of this entity's minimum light with a subtle noise pattern." =
	[
		0 : "Flat"
		1 : "Mottled"
	]
	_shadowself(choices) : "Self Shadowing" : 0 : "COMPILER (light): lets this entity cast shadows " +
		"onto itself without casting them onto anything else. Overridden by '_shadow'. " +
		"Alias: '_selfshadow'." =
	[
		0 : "Off"
		1 : "On"
	]
	_shadowworldonly(choices) : "Shadow On World Only" : 0 : "COMPILER (light): lets this entity " +
		"cast shadows onto the world but not onto itself or other brush models. Overridden by " +
		"'_shadow'." =
	[
		0 : "Off"
		1 : "On"
	]
	_switchableshadow(choices) : "Switchable Shadow" : 0 : "COMPILER (light): allows this " +
		"entity's shadow to be turned on and off during play. light assigns a light style for the " +
		"shadow and writes it back into the 'switchshadstyle' key, which mod code then animates. " +
		"Entities sharing a targetname share one style. Only unstyled light is blocked." =
	[
		0 : "Off"
		1 : "On"
	]
	switchshadstyle(integer) : "Switchable Shadow Style" : 0 : "COMPILER (light): light style " +
		"number allocated for this entity's switchable shadow. light writes this key itself; set " +
		"it by hand only to pin a specific style."
	_autominlight(choices) : "Automatic Minimum Light" : 0 : "COMPILER (light): samples the light " +
		"actually reaching the entity and uses it as the minimum light, so an unlit underside " +
		"picks up its surroundings rather than a flat value." =
	[
		-1 : "Off"
		0 : "Apply to occluded surfaces only"
		1 : "Apply to all surfaces"
	]
	_autominlight_target(string) : "Automatic Minimum Light Source" : : "COMPILER (light): " +
		"targetname of an entity whose position is sampled for the automatic minimum light, " +
		"instead of sampling at the entity itself."
]

@BaseClass base(BrushCompiler, BrushModel) = Bmodel []


//=============================================================================
// Compile-time brush entities
//
// These entities exist only while the map is compiled. Their brushes are
// merged into the world and the entities themselves never reach the server.
//=============================================================================

@SolidClass base(BrushCompiler) = func_detail : "Brush that vis ignores, which can cut map " +
	"compile times dramatically. Detail brushes are solid and do split the world faces behind " +
	"them, but they do not block visibility, so they never help vis close off parts of the map.\n" +
	"\n" +
	"Detail brushes do not seal the map against the void. The shell of the map must be built " +
	"from ordinary world brushes." []

@SolidClass base(BrushCompiler) = func_detail_illusionary : "Detail brush with no collision, " +
	"which players, monsters and shots pass straight through. It does not split the world faces " +
	"behind it and casts no shadow unless '_shadow' is set to 1. Suited to hanging vines, " +
	"cobwebs and similar decoration." []

@SolidClass base(BrushCompiler) = func_detail_wall : "Detail brush that does not split the world " +
	"faces behind it, at the cost of some overdraw. Suited to trim and decoration sitting " +
	"against a wall or floor that would otherwise carve up a large flat face.\n" +
	"\n" +
	"A world face completely covered by one of these is still clipped away, so this is not " +
	"suitable for fence textures. Use func_detail_fence for those." []

@SolidClass base(BrushCompiler) = func_detail_fence : "Detail brush that never clips away the " +
	"world faces behind it, so surfaces seen through its transparent texture are preserved. " +
	"Suited to grates, railings and fences that are solid and stop shots." []

@SolidClass base(BrushCompiler) = func_group : "Groups brushes together for organisation in the " +
	"editor and to apply compiler keys to all of them at once. The brushes are treated exactly " +
	"as world brushes and the grouping has no effect in game." []

@SolidClass base(BrushCompiler) = func_illusionary_visblocker : "Brush with no collision that " +
	"still blocks visibility. Players and shots pass through it while vis treats it as opaque, " +
	"which allows a visually open doorway to close off the room beyond it." []

@SolidClass base(BrushCompiler, Targetname) = func_areaportal : "Q2 ONLY: closes off visibility " +
	"between two areas of the map while the door filling it is shut. Must consist of exactly one " +
	"brush, placed to fill the doorway. Has no effect in a Quake map." []

@PointClass color(128 128 128) size(-8 -8 -8, 8 8 8) = misc_external_map : "COMPILER (qbsp): " +
	"imports brushes from another .map file at this position. The external file should contain " +
	"worldspawn brushes only, and its own 'wad' key is ignored, so every texture it uses must be " +
	"available to this map.\n" +
	"\n" +
	"Any other key set here is passed through to the entity the brushes become, so targetname, " +
	"lighting keys and the like can be set on the prefab."
[
	_external_map(string) : "Map File" : : "COMPILER (qbsp): path to the .map file to import."
	_external_map_classname(string) : "Imported Classname" : : "COMPILER (qbsp): classname the " +
		"imported brushes are turned into, such as func_detail or func_wall."
	_external_map_angles(string) : "Rotation" : "0 0 0" : "COMPILER (qbsp): rotation applied to " +
		"the imported brushes, as 'pitch yaw roll'."
	_external_map_angle(float) : "Rotation (Yaw Only)" : : "COMPILER (qbsp): rotation around the " +
		"vertical axis only. Ignored when '_external_map_angles' is set."
	_external_map_scale(string) : "Scale" : "1" : "COMPILER (qbsp): scale applied to the imported " +
		"brushes, either as one number or as 'x y z'."
]

// Keys qbsp reads from any point entity, rather than from an entity of its own.
@BaseClass = PointCompiler [
	_nofill(choices) : "Allow Outside The Map" : 0 : "COMPILER (qbsp): stops this entity being " +
		"reported as a leak when it sits outside the sealed part of the map." =
	[
		0 : "Off"
		1 : "On"
	]
	_lightgrid_hint(choices) : "Light Grid Bounds Hint" : 0 : "COMPILER: includes this entity in " +
		"the volume the light grid is built to cover, and exempts it from leak filling." =
	[
		0 : "Off"
		1 : "On"
	]
]


//=============================================================================
// Lights
//
// Every light key is read by the light compiler and stripped from the finished
// BSP. light treats any entity whose classname begins with "light" as a light
// source, which is why the decorative light entities below carry the full set
// of light keys.
//
// A light becomes a spotlight as soon as it is aimed, either by targeting
// another entity or by setting a mangle. Naming a light makes it switchable:
// light allocates a style number for it and overwrites whatever is in the
// style key, so a named light cannot also be an animated one.
//=============================================================================

@BaseClass = LightStartOff [
	spawnflags(flags) =
	[
		1 : "Start off" : 0 : "The light is dark until something switches it on. Requires a " +
			"targetname."
	]
]

@BaseClass color(255 255 40) = LightCore [
	light(integer) : "Brightness" : 300 : "COMPILER (light): brightness of the light. Negative " +
		"values subtract light from their surroundings, which is a way to darken an area " +
		"selectively. May also be written as 'red green blue brightness' to set colour and " +
		"brightness together, though '_color' is the clearer way to do that."
	_color(color255) : "Colour" : "255 255 255" : "COMPILER (light): colour of the light."
	style(choices) : "Animation" : 0 : "COMPILER (light): animated brightness pattern. Ignored on " +
		"a named light, because light allocates a style of its own for switching it." =
	[
		0 : "Normal - steady"
		1 : "Flicker A"
		2 : "Slow strong pulse"
		3 : "Candle A"
		4 : "Fast strobe"
		5 : "Gentle pulse"
		6 : "Flicker B"
		7 : "Candle B"
		8 : "Candle C"
		9 : "Slow strobe"
		10 : "Fluorescent flicker"
		11 : "Slow pulse, never black"
	]
	delay(choices) : "Falloff Formula" : 0 : "COMPILER (light): how brightness falls off with " +
		"distance. The names in quotes may also be used in place of the numbers." =
	[
		0 : "Linear - reaches a fixed distance and stops"
		1 : "Inverse - 1/distance"
		2 : "Inverse square - 1/distance squared"
		3 : "Infinite - equally bright at any distance"
		4 : "Local minimum light - flat fill, only where the light can see"
		5 : "Inverse square, softened - dimmer at the source and less harsh nearby"
	]
	wait(float) : "Fade Distance Scale" : "1.0" : "COMPILER (light): scales how far this light " +
		"reaches. Values above 1.0 make it fade out sooner, values below 1.0 carry it further."
	_falloff(float) : "Hard Fade Distance" : "0" : "COMPILER (light): distance in units at which " +
		"the light reaches zero brightness, replacing the usual falloff calculation. 'Brightness' " +
		"then sets only how bright the light is at its centre. Applies to linear falloff only; " +
		"light warns and ignores it with any other formula."
	_anglescale(float) : "Angle Falloff" : "-1" : "COMPILER (light): how much the angle between a " +
		"surface and this light affects its brightness, from 0 for no effect to 1 for full " +
		"realistic falloff. -1 uses the map-wide setting."
	_dirt(choices) : "Ambient Occlusion" : 0 : "COMPILER (light): whether ambient occlusion " +
		"darkens the light this entity casts." =
	[
		-1 : "This light is never occluded"
		0 : "Follow the worldspawn '_dirt' setting"
		1 : "Occlude this light"
	]
	_dirtscale(float) : "Ambient Occlusion Strength" : "0" : "COMPILER (light): overrides the " +
		"map-wide occlusion strength for this light alone. 0 uses the map-wide value."
	_dirtgain(float) : "Ambient Occlusion Falloff" : "0" : "COMPILER (light): overrides the " +
		"map-wide occlusion falloff exponent for this light alone. 0 uses the map-wide value."
	_dirt_off_radius(float) : "Occlusion Fade-in Start" : "0" : "COMPILER (light): distance in " +
		"units within which this light casts no ambient occlusion at all. Occlusion then fades " +
		"in between this distance and the fade-in end. Both keys must be set for either to apply."
	_dirt_on_radius(float) : "Occlusion Fade-in End" : "0" : "COMPILER (light): distance in units " +
		"beyond which this light's ambient occlusion is at full strength."
	_deviance(float) : "Soft Shadow Radius" : "0" : "COMPILER (light): scatters this light into a " +
		"sphere of smaller lights of the given radius in units, which softens the shadow edges it " +
		"casts. The total brightness is divided between them."
	_samples(integer) : "Soft Shadow Samples" : 16 : "COMPILER (light): how many lights the sphere " +
		"is made of. Higher values give smoother shadows and slower compiles. Only used when a " +
		"soft shadow radius is set."
	_bouncescale(float) : "Bounce Light Scale" : "1.0" : "COMPILER (light): scales how much this " +
		"light contributes to bounced lighting. 0 stops it bouncing entirely."
]

@BaseClass = LightSpot [
	target(target_destination) : "Aim At" : : "COMPILER (light): name of an entity to aim at, " +
		"usually an info_null. Aiming a light turns it into a spotlight."
	mangle(string) : "Aim Direction" : : "COMPILER (light): direction to aim, as 'yaw pitch roll', " +
		"where '0 -90 0' points straight down. Aiming a light turns it into a spotlight. Ignored " +
		"when the light targets an entity."
	angle(float) : "Cone Width" : "40" : "COMPILER (light): full width of the spotlight cone in " +
		"degrees."
	_softangle(float) : "Cone Inner Width" : "0" : "COMPILER (light): width in degrees of an inner " +
		"cone at full brightness, with the light fading between it and the outer cone. Must be " +
		"smaller than the cone width. 0 gives a hard-edged cone."
	_cone(float) : "Cone Radius (Quake II style)" : "10" : "COMPILER (light): half the width of " +
		"the spotlight cone in degrees, the way the Quake II tools express it. Setting this takes " +
		"precedence over the cone width."
]

@BaseClass = LightSun [
	_sun(choices) : "Act As Sun" : 0 : "COMPILER (light): turns this light into a sun. It stops " +
		"lighting from its own position and instead casts parallel light out of every sky " +
		"surface, in the direction the light is aimed. Use this instead of the worldspawn sun " +
		"keys when a map needs more than two suns, or a sun with its own style." =
	[
		0 : "Ordinary light"
		1 : "Sun"
	]
	_sunlight2(choices) : "Act As Sky Dome" : 0 : "COMPILER (light): turns this light into a dome " +
		"of lights above the horizon emitting from sky surfaces, giving soft light from the whole " +
		"sky rather than one direction." =
	[
		0 : "Ordinary light"
		1 : "Sky dome"
	]
	_sunlight3(choices) : "Act As Ground Dome" : 0 : "COMPILER (light): turns this light into a " +
		"dome of lights below the horizon emitting from sky surfaces, acting as light bounced up " +
		"off the ground." =
	[
		0 : "Ordinary light"
		1 : "Ground dome"
	]
	_suntexture(string) : "Sun Sky Texture" : : "COMPILER (light): name of the sky texture this " +
		"sun shines out of, when the map has more than one sky texture and each should light the " +
		"map differently."
]

@BaseClass = LightSurface [
	_surface(string) : "Emissive Texture" : : "COMPILER (light): name of a texture that should " +
		"give off light. This entity stops being a light in its own right and becomes a template: " +
		"every surface in the map using that texture emits light with these settings."
	_surface_offset(float) : "Emissive Surface Offset" : "2" : "COMPILER (light): how far in units " +
		"the emitted light sits in front of the surfaces it comes from."
	_surface_spotlight(choices) : "Emissive Surface Direction" : 0 : "COMPILER (light): whether " +
		"the light from each surface is aimed away from that surface instead of shining in all " +
		"directions." =
	[
		0 : "Shine in all directions"
		1 : "Aim away from the surface"
	]
	_surface_radiosity(choices) : "Emissive Surface Method" : 0 : "COMPILER (light): which " +
		"algorithm this template uses, overriding the map-wide setting." =
	[
		0 : "Subdivision - place point lights over the surface"
		1 : "Radiosity - treat the surface as an area light"
	]
	_surface_is_sky(choices) : "Treat As Sky Emission" : 0 : "COMPILER (light): treats the light " +
		"from this template as sky light, which changes how its emission is scaled by surface " +
		"area." =
	[
		0 : "Ordinary surface light"
		1 : "Sky light"
	]
	_surflight_group(integer) : "Surface Light Group" : 0 : "COMPILER (light): restricts this " +
		"template to brush entities carrying the same group number, so the same texture can emit " +
		"differently in different places."
	_surflight_minlight_scale(float) : "Surface Light Self-Illumination" : "1.0" : "COMPILER " +
		"(light): scales the minimum light given to the emissive surfaces themselves, so a light " +
		"fixture does not render black."
	_surflight_atten(float) : "Surface Light Attenuation" : "1.0" : "COMPILER (light): scales how " +
		"quickly the light from these surfaces falls off with distance."
]

@BaseClass = LightProject [
	_project_texture(string) : "Projected Texture" : : "COMPILER (light): name of a texture this " +
		"light projects, in the manner of a slide projector or a gobo. The texture must be used " +
		"somewhere in the map so that it is available to the compiler."
	_project_mangle(string) : "Projection Direction" : "20 0 0" : "COMPILER (light): direction the " +
		"texture is projected, as 'yaw pitch roll'. Defaults to the light's own aim direction."
	_project_fov(float) : "Projection Field Of View" : "90" : "COMPILER (light): angular width of " +
		"the projected image in degrees. Wider values spread the image over a larger area."
]

@BaseClass = LightAdvanced [
	_nostaticlight(choices) : "Exclude From Lightmap" : 0 : "COMPILER (light): stops this light " +
		"contributing to the lightmap, leaving it to affect only the light grid." =
	[
		0 : "Light the map normally"
		1 : "Do not light the map"
	]
	_bleed(choices) : "Light Through Surfaces" : 0 : "COMPILER (light): lets this light reach the " +
		"back faces of surfaces facing away from it, ignoring the fact that they are turned away." =
	[
		0 : "Off"
		1 : "On"
	]
	_nonudge(choices) : "Do Not Reposition" : 0 : "COMPILER (light): stops light from nudging this " +
		"entity out of a solid brush before lighting. A light embedded in a wall normally gets " +
		"moved into open space so that it is not swallowed by the geometry." =
	[
		0 : "Move the light out of solid"
		1 : "Light from exactly this position"
	]
	_light_channel_mask(integer) : "Light Channel Mask" : 1 : "COMPILER (light): bitmask of the " +
		"lighting channels this light shines on. It only lights brush entities that share one of " +
		"its channels."
	_shadow_channel_mask(integer) : "Shadow Channel Mask" : 1 : "COMPILER (light): bitmask of the " +
		"lighting channels whose geometry casts shadows from this light. Defaults to the light " +
		"channel mask, and setting it separately allows a light to pass through geometry that " +
		"still blocks other lights."
	_switchableshadow_target(string) : "Switchable Shadow Target" : : "COMPILER (light): " +
		"targetname of a brush entity whose shadow should be switchable without any mod support. " +
		"light works out the difference this entity's shadow makes and stores it in a light " +
		"style, so switching the style switches the shadow. Implies that this light does not " +
		"contribute to the static lightmap."
]

@BaseClass base(Targetname, Appearflags, PointCompiler, LightCore, LightSpot, LightSun,
	LightSurface, LightProject, LightAdvanced) = CompilerLight []

@PointClass base(CompilerLight, LightStartOff) = light : "Invisible light source. Acts as a point " +
	"light by default, becomes a spotlight when aimed at a target or given a direction, and can " +
	"be turned into a sun, a sky dome or an emissive-texture template with the keys below." []

@PointClass base(CompilerLight, LightStartOff) size(-8 -8 -8, 8 8 8)
	model({ "path": ":progs/s_light.spr" }) =
	light_globe : "Light source with a visible glowing globe sprite." []

