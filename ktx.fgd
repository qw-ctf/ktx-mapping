//=============================================================================
// Doors, platforms and other movers
//=============================================================================

@BaseClass = DoorSounds [
	sounds(choices) : "Movement Sound" : 0 =
	[
		0 : "Silent"
		1 : "Stone"
		2 : "Machine"
		3 : "Stone chain"
		4 : "Screechy metal"
	]
]

@SolidClass base(Appearflags, Target, Targetname, Angle, Alpha, Bmodel, DoorSounds) =
	func_door : "Sliding door. Opens in the direction it faces when a player touches it, shoots " +
	"it or triggers it, and closes again after a delay.

Doors that touch each other are linked into one, so that opening any part opens the whole " +
	"door. The key sounds a locked door plays are chosen by the worldtype set in worldspawn."
[
	speed(integer) : "Speed" : 100 : "How fast the door moves, in units per second."
	lip(integer) : "Lip" : 8 : "How many units of the door remain visible when it is fully open."
	wait(float) : "Wait Before Closing" : "3" : "Seconds the door stays open. -1 leaves it open " +
		"permanently."
	dmg(integer) : "Crush Damage" : 2 : "Damage dealt to anything blocking the door."
	health(integer) : "Health (shootable)" : 0 : "Setting this makes the door open when shot " +
		"rather than when touched."
	message(string) : "Message" : : "Text shown to a player who opens the door."
	spawnflags(flags) =
	[
