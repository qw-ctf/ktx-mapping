@PointClass base(Item) size(-16 -16 -24, 16 16 32) color(80 0 200)
	model({ "path": ":progs/w_s_key.mdl" }) =
	item_key1 : "First key of the map. The worldtype set in worldspawn decides what it looks " +
	"like and what it is called: a silver key in a medieval map, a silver runekey in a runic " +
	"one, or a security keycard in a base map. The editor always previews the medieval model." []

@PointClass base(Item) size(-16 -16 -24, 16 16 32) color(80 0 200)
	model({ "path": ":progs/w_g_key.mdl" }) =
	item_key2 : "Second key of the map. The worldtype set in worldspawn decides what it looks " +
	"like and what it is called: a gold key in a medieval map, a gold runekey in a runic one, or " +
	"an industrial keycard in a base map. The editor always previews the medieval model." []

@PointClass base(Item) size(-16 -16 -24, 16 16 32) color(80 0 200)
	model({{
