@PointClass base(Item) size(-16 -16 -24, 16 16 32) color(80 0 200)
	model({ "path": ":progs/suit.mdl" }) =
	item_artifact_envirosuit : "Biosuit. Protects the carrier from slime, lava and drowning for " +
