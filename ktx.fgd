//=============================================================================
// KTX brush entities
//=============================================================================

@SolidClass base(Appearflags, Targetname, Alpha, Bmodel) = func_bob : "KTX: brush model that " +
	"drifts gently back and forth, for floating platforms and hanging objects.

This entity came from two different mods that gave its flags opposite meanings, and KTX " +
	"implements neither cleanly: setting bit 1 or bit 4 deletes the entity when the map loads, " +
	"and bit 2 does nothing. Leave the spawnflags at zero."
[
	angle(integer) : "Movement Direction" : 0 : "Direction the entity drifts, in degrees. Use 360 " +
		"for due east, -1 for straight up and -2 for straight down."
	height(integer) : "Movement Distance" : 8 : "How far the entity travels from its resting " +
		"position, in units."
	count(integer) : "Cycle Time" : 2 : "Seconds between changes of direction. Must be at least 1."
	waitmin(float) : "Acceleration Curve" : "1" : "Shapes the start of each movement. 1 moves at " +
		"a steady rate; higher values ease in more sharply."
	waitmin2(float) : "Deceleration Curve" : "0.75" : "Shapes the end of each movement, easing " +
		"the entity to a halt."
	delay(float) : "Start Offset" : "0" : "Seconds to wait before starting to move, which lets " +
		"several bobbing entities run out of step with one another. A negative value picks a " +
		"random offset."
]

@SolidClass base(Appearflags, Targetname, Target, Bmodel) = func_laser : "KTX: damaging laser " +
	"barrier that can be switched on and off, used to block a route or to hurt players who cross " +
	"it. The brush flickers around its set opacity while active.

A laser that is switched off is moved far out of the map rather than hidden, so it cannot be " +
	"touched while off. Damage is dealt at most three times a second to any one player."
[
	dmg(integer) : "Damage" : 1 : "Damage dealt on touch. Set to -1 for a laser that blocks and " +
		"startles without hurting."
	alpha(float) : "Opacity" : "0.5" : "Opacity of the laser, from 0.0 to 1.0. The drawn opacity " +
		"varies continuously within about 20 percent of this value to give the beam a flicker."
	noise(string) : "Switch On Sound" : "buttons/switch02.wav" : "KTX: sound played when the " +
		"laser is switched on."
	noise1(string) : "Switch Off Sound" : "buttons/switch04.wav" : "KTX: sound played when the " +
		"laser is switched off."
	noise2(string) : "Damage Sound" : "misc/null.wav" : "KTX: sound played when the laser hurts " +
		"somebody. Silent unless a sound is set."
	spawnflags(flags) =
	[
		1 : "Start off" : 0 : "The laser is inactive until something switches it on."
		2 : "Solid" : 0 : "The laser blocks movement and shots while it is on, rather than only " +
			"hurting what passes through it."
	]
]


//=============================================================================
// Ambient sounds
//
// The preset ambient entities take no keys beyond their position. Each one
// registers a looping sound that fades with distance and then removes itself,
// so it costs nothing at runtime.
//=============================================================================

@BaseClass base(Appearflags) size(-8 -8 -8, 8 8 8) color(64 32 192) = Ambient []

@PointClass base(Ambient) = ambient_general : "Looping ambient sound of the mapper's choosing, " +
	"registered at this position and fading with distance."
[
	noise(string) : "Sound File" : : "REQUIRED: path to the sound to loop, such as " +
		"'ambience/windfly.wav'. The map fails to load if this is left empty."
	volume(float) : "Volume" : "0.5" : "Loudness of the sound, from 0.0 to 1.0."
	speed(choices) : "Falloff" : 0 : "How quickly the sound fades with distance." =
	[
		-1 : "None - heard everywhere on the map"
		0 : "Normal"
		2 : "Idle - fades over a short distance"
		3 : "Static - fades over the shortest distance"
	]
]

@PointClass base(Ambient) = ambient_drip : "Looping sound of dripping water." []
@PointClass base(Ambient) = ambient_drone : "Looping sound of machinery or an engine." []
@PointClass base(Ambient) = ambient_comp_hum : "Looping hum of computer equipment." []
@PointClass base(Ambient) = ambient_flouro_buzz : "Looping buzz of a fluorescent tube. Note the " +
	"misspelling in the classname, which KTX matches exactly." []
@PointClass base(Ambient) = ambient_light_buzz : "Looping electrical buzz of a light fitting." []
@PointClass base(Ambient) = ambient_suck_wind : "Looping sound of wind." []
@PointClass base(Ambient) = ambient_swamp1 : "Looping sound of croaking frogs." []
@PointClass base(Ambient) = ambient_swamp2 : "Looping sound of croaking frogs, second variant." []
@PointClass base(Ambient) = ambient_thunder : "Looping sound of distant thunder." []

@PointClass base(Appearflags) size(-10 -10 -10, 10 10 10) color(64 32 192) =
	misc_noisemaker : "Plays a burst of enforcer sounds twice a second, without pause. This " +
