@PointClass base(CompilerLight, LightStartOff) size(-8 -8 -8, 8 8 8)
	model({ "path": ":progs/flame2.mdl" }) =
	light_flame_small_yellow : "Small yellow flame ball with a burning sound. The model is made " +
