		"1" : "Normal"
		"2" : "Hard"
		"3" : "Nightmare"
	]
]

@PointClass base(Appearflags, Target, Targetname) size(-8 -8 -8, 8 8 8) color(128 0 128) =
	trigger_counter : "Fires its target only after being triggered a set number of times. Acts " +
