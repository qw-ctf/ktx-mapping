@PointClass base(Item) size(-16 -16 -24, 16 16 32) color(80 0 200)
	model({ "path": ":progs/invisibl.mdl" }) =
	item_artifact_invisibility : "Ring of shadows. Makes the carrier nearly invisible for 30 " +
