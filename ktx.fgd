@PointClass base(CompilerLight, LightStartOff) size(-10 -10 -12, 12 12 18)
	model({ "path": ":progs/flame2.mdl", "frame": 1 }) =
	light_flame_large_yellow : "Large yellow flame ball with a burning sound. The model is made " +
