@PointClass base(Weapon) model({ "path": ":progs/g_light.mdl" }) =
	weapon_lightning : "Thunderbolt. Fires a continuous lightning beam, and discharges all " +
	"remaining cells at once if fired under water." []


//=============================================================================
// Triggers
//
// KTX only lets touch triggers fire while a match is running or the server is
// in practice mode, so a trigger will appear to do nothing on an idle server.
//=============================================================================

@BaseClass base(Appearflags, Target, Targetname, Race) = Trigger [
	message(string) : "Message" : : "Text shown to the player who sets the trigger off. A \b " +
		"character toggles red text for the characters that follow."
	delay(float) : "Trigger Delay" : "0" : "Seconds to wait between this trigger firing and its " +
		"target being activated."
	sounds(choices) : "Activation Sound" : 0 =
	[
		0 : "Silent"
		1 : "Secret discovered"
		2 : "Talk beep"
		3 : "Large switch"
	]
]

@BaseClass = TriggerTouch [
	health(integer) : "Health (shootable)" : 0 : "Setting this makes the trigger fire when it is " +
		"shot rather than when it is touched. Cannot be combined with the not touchable flag."
	angle(integer) : "Facing Direction" : 0 : "When set, the trigger only fires if the player is " +
		"facing roughly this way as they touch it. Use 360 for due east."
	spawnflags(flags) =
	[
		1 : "Not touchable" : 0 : "The trigger can only be fired by another entity, never by " +
			"walking into it. Superseded by trigger_relay."
	]
]

@BaseClass base(Appearflags, Targetname, Race) = TriggerPoint [
	size(string) : "Trigger Size" : "16 16 16" : "KTX: half the size of the trigger volume in " +
		"units, as 'x y z'. The volume is centred on this entity and extends this far along each " +
		"axis in both directions, so '16 16 16' gives a box 32 units across."
]

@SolidClass base(Trigger, TriggerTouch) = trigger_multiple : "Fires its target whenever a player " +
	"touches it, and can fire again after a delay."
[
	wait(float) : "Rearm Delay" : "0.2" : "Seconds before the trigger can fire again."
]

@SolidClass base(Trigger, TriggerTouch) = trigger_once : "Fires its target the first time a " +
	"player touches it, then never again." []

@PointClass base(Trigger) size(-8 -8 -8, 8 8 8) color(128 0 128) = trigger_relay : "Fires its " +
	"target when another entity fires it. Has no volume and cannot be touched, which makes it " +
	"the usual way to add a delay or a message to a chain of triggers." []

@SolidClass base(Trigger, TriggerTouch) = trigger_secret : "Counts as a secret when a player " +
	"first touches it, and fires its target. Adds one to the map's secret total."
[
	sounds(choices) : "Discovery Sound" : 1 =
	[
		1 : "Secret discovered"
		2 : "Talk beep"
	]
]

@SolidClass base(Trigger, TriggerTouch) = trigger_onlyregistered : "Fires its target only for " +
	"players running the registered version of Quake. Every modern copy is registered, so this " +
	"is effectively an ordinary trigger." []

@SolidClass base(Appearflags, Target, Targetname, Race) = trigger_teleport : "Teleports whatever " +
	"touches it to an info_teleport_destination. Giving the teleporter a name stops it working " +
	"on touch until something fires it."
[
	ktx_votemap(string) : "Vote Map" : : "KTX: name of a map. While no match is in progress, a " +
		"player who steps into this teleporter casts a vote for that map. This is how map " +
		"selection rooms are built."
	spawnflags(flags) =
	[
		1 : "Players only" : 0 : "Only players are teleported. Other entities, including " +
			"grenades, pass through."
		2 : "Silent" : 0 : "Suppresses the humming sound the teleporter otherwise emits."
	]
]

@PointClass base(TriggerPoint, Target) size(-16 -16 -16, 16 16 16) =
	trigger_custom_teleport : "KTX: teleporter defined by a point and a size rather than by " +
	"brushes, which allows a teleport volume to be placed without building geometry for it. " +
	"Behaves exactly like trigger_teleport once the map loads."
[
	spawnflags(flags) =
	[
		1 : "Players only" : 0 : "Only players are teleported."
		2 : "Silent" : 0 : "Suppresses the humming sound."
	]
]

@PointClass base(Appearflags, Targetname) size(-8 -8 -8, 8 8 32) color(128 0 128) =
	info_teleport_destination : "Exit point of a teleporter. The direction this entity faces is " +
	"the direction players leave the teleporter looking. KTX raises it 27 units on map load so " +
	"that a destination placed on the floor puts the player's feet on the floor."
[
	angles(string) : "Exit Angles" : "0 0 0" : "Direction players face on arrival, as " +
		"'pitch yaw roll'."
	targetname(target_source) : "Name" : : "REQUIRED: name matching the teleporter's target key. " +
		"The map fails to load without it."
]

@SolidClass base(Appearflags, Targetname, Race) = trigger_push : "Pushes whatever touches it in " +
	"the direction it faces, which is how wind tunnels and jump pads are built. Grenades are " +
	"pushed as well as players."
[
	angle(integer) : "Push Direction" : 0 : "Direction to push, in degrees. Use -1 for straight " +
		"up and -2 for straight down."
	speed(integer) : "Push Speed" : 1000 : "Strength of the push."
	spawnflags(flags) =
	[
		1 : "Push once" : 0 : "The trigger removes itself after pushing something once."
	]
]

@PointClass base(TriggerPoint) size(-16 -16 -16, 16 16 16) =
	trigger_custom_push : "KTX: push trigger defined by a point and a size rather than by " +
	"brushes. Behaves exactly like trigger_push once the map loads."
[
	angle(integer) : "Push Direction" : 0 : "Direction to push, in degrees. Use -1 for straight " +
		"up and -2 for straight down."
	speed(integer) : "Push Speed" : 1000 : "Strength of the push."
	spawnflags(flags) =
	[
		1 : "Push once" : 0 : "The trigger removes itself after pushing something once."
	]
]

@SolidClass base(Appearflags, Targetname, Race) = trigger_hurt : "Injures whatever touches it. " +
	"After hurting something the trigger goes quiet for one second, so standing in it costs the " +
	"stated damage about once a second."
[
	dmg(integer) : "Damage" : 5 : "Damage dealt each time the trigger fires."
]

@SolidClass base(Appearflags, Targetname, Race) = trigger_heal : "KTX: heals players who walk " +
	"into it, up to a limit, with a pause between one player's heals. Inactive while the server " +
	"is waiting for a match to start."
[
	heal_amount(integer) : "Heal Amount" : 5 : "KTX: health restored each time a player is healed."
	wait(float) : "Heal Interval" : "1" : "KTX: seconds a player must wait between heals."
	noise(string) : "Heal Sound" : "items/r_item1.wav" : "KTX: sound played each time a player " +
		"is healed."
]

@SolidClass base(Appearflags, Targetname, Race) = trigger_monsterjump : "Makes walking monsters " +
	"that touch it leap in the direction it faces. Has no effect on players."
[
	angle(integer) : "Jump Direction" : 0 : "Direction to throw monsters, in degrees. Use 360 " +
		"for due east."
	speed(integer) : "Forward Speed" : 200 : "How hard monsters are thrown forwards."
	height(integer) : "Jump Height" : 200 : "How hard monsters are thrown upwards."
]

@PointClass base(TriggerPoint) size(-16 -16 -16, 16 16 16) =
	trigger_custom_monsterjump : "KTX: monster jump trigger defined by a point and a size rather " +
