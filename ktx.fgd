	]
]

@PointClass base(Monster) size(-128 -128 -24, 128 128 256) model({ "path": ":progs/boss.mdl" }) =
	monster_boss : "Chthon, the lava boss. Cannot be hurt by weapons and has to be killed with " +
	"the lightning trap built from event_lightning." []

@PointClass base(Monster) size(-16 -16 -24, 16 16 32) model({ "path": ":progs/oldone.mdl" }) =
	monster_oldone : "Shub-Niggurath, the final boss. Killed by telefragging." []

@PointClass base(Appearflags, Target, Targetname) size(-16 -16 -24, 16 16 40) color(220 0 0) =
	info_monster_start : "Position a monster is teleported in at when it is spawned during play " +
	"rather than placed in the map. Removed in deathmatch." []


//=============================================================================
// Rotating brush entities
//
// Rotation is built from three entities working together:
//
//   info_rotate     marks the axis the brushes turn around.
//   rotate_object   holds the brushes that turn. It targets the info_rotate.
//   a controller    func_rotate_entity for continuous spinning, or
//                   func_rotate_door for something that turns between two
//                   positions. Both are point entities placed on the axis,
//                   and both target the rotate_object.
//
// Rotating brushes carry no collision of their own. To make one solid, cover
// its volume with func_movewall entities sharing the rotate_object's name;
// they travel the same circular path without turning, so several small ones
// are needed to approximate the shape.
//=============================================================================

@PointClass base(Appearflags, Targetname) size(-8 -8 -8, 8 8 8) color(0 128 0) =
	info_rotate : "Axis that rotating brushes turn around. Place it at the centre of rotation " +
	"and give it a name for the rotate_object to target. It removes itself once the rotating " +
	"entities have found it." []

@SolidClass base(Appearflags, Targetname, Target, Alpha, Bmodel) color(0 128 204) =
	rotate_object : "Brushes that are rotated by a func_rotate_entity or func_rotate_door. It " +
	"has no collision and does not move on its own."
[
	target(target_destination) : "Axis" : : "REQUIRED: name of the info_rotate this object turns " +
		"around."
]

@PointClass base(Appearflags, Targetname, Target) size(-8 -8 -8, 8 8 8) color(64 128 64) =
	func_rotate_entity : "Turns a rotate_object continuously. Triggering it starts and stops the " +
	"rotation, easing in and out over the acceleration time."
[
	target(target_destination) : "Rotating Brushes" : : "REQUIRED: name of the rotate_object to " +
		"turn."
	rotate(string) : "Rotation Speed" : "0 0 0" : "Degrees per second around each axis, as " +
		"'pitch yaw roll'. '0 90 0' spins anticlockwise about the vertical axis at 90 degrees a " +
		"second; negate a value to reverse that axis."
	speed(float) : "Acceleration Time" : "5" : "Seconds taken to reach full speed from rest, and " +
		"to slow back down."
	spawnflags(flags) =
	[
		1 : "Toggle" : 0 : "Each trigger reverses whether the object is turning, instead of " +
			"starting it each time."
		2 : "Start on" : 0 : "The object is already turning when the map begins."
	]
]

@PointClass base(Appearflags, Targetname, Target) size(-8 -8 -8, 8 8 8) color(64 128 64) =
	func_rotate_door : "Turns a rotate_object between a closed and an open position each time it " +
	"is triggered, for gates and hatches that swing rather than slide.

Place this entity at the same position as the info_rotate. The angles set here are the open " +
	"position; the brushes start at zero and turn to those angles."
[
	target(target_destination) : "Rotating Brushes" : : "REQUIRED: name of the rotate_object to " +
		"turn. The map fails to load without it."
	angles(string) : "Open Position" : "0 0 0" : "Angles the door turns to when opened, as " +
		"'pitch yaw roll'. Values beyond 180 degrees force the door to take the long way round."
	speed(float) : "Movement Time" : "2" : "Seconds taken to swing between closed and open."
	dmg(integer) : "Crush Damage" : 2 : "Damage dealt to anything the door is blocked by. " +
		"Negative values are treated as none."
	group(string) : "Link Group" : : "KTX: name shared with other rotating doors so that they " +
		"open and close together and reverse as one."
	sounds(choices) : "Movement Sound" : 1 =
	[
		1 : "Medieval - latch and winch"
		2 : "Metal - airlock"
		3 : "Base - security door"
	]
	spawnflags(flags) =
	[
		1 : "Stay open" : 0 : "The door reopens after closing, which stops a door that is " +
			"triggered once from shutting again when something blocks it."
	]
]

@SolidClass base(Appearflags, Targetname, Target, Alpha, Bmodel) color(64 128 64) =
	func_rotate_train : "Brush model that travels between path_rotate entities and can turn as " +
	"it goes. It is the centre of rotation for everything it targets.

Give it a name to keep it waiting until it is triggered; without one it starts moving as " +
	"soon as the map loads."
[
	target(target_destination) : "Rotating Brushes" : : "REQUIRED: name of the object this train " +
		"carries and rotates. The map fails to load without it."
	path(target_destination) : "First Stop" : : "REQUIRED: name of the path_rotate the train " +
		"starts at. The map fails to load if this does not name a path_rotate."
	speed(integer) : "Speed" : 100 : "How fast the train moves, in units per second."
	dmg(integer) : "Crush Damage" : 0 : "Damage dealt to anything blocking the train."
	noise(string) : "Stop Sound" : : "Sound played when the train stops. Defaults to a sound " +
		"chosen by the movement sound setting."
	noise1(string) : "Moving Sound" : : "Sound played while the train moves. Defaults to a sound " +
		"chosen by the movement sound setting."
	sounds(choices) : "Movement Sound" : 0 =
	[
		0 : "Silent"
		1 : "Ratchet metal"
	]
]

@PointClass base(Appearflags, Targetname, Target) size(-8 -8 -8, 8 8 8) color(128 64 0) =
	path_rotate : "Stop on the route of a func_rotate_train, which also controls how the train " +
	"turns and behaves on the way to this point."
[
	target(target_destination) : "Next Stop" : : "Name of the next path_rotate on the route."
	rotate(string) : "Rotation Speed" : "0 0 0" : "Degrees per second around each axis while " +
		"travelling to this stop, as 'pitch yaw roll'. Requires the rotation flag. Use '0 0 0' " +
		"to stop an existing rotation."
	angles(string) : "Turn To Angles" : "0 0 0" : "Angles the train turns to while travelling to " +
		"this stop, as 'pitch yaw roll'. Requires the angles flag. Values below 0 or above 360 " +
		"force the turn to go a particular way round."
	speed(float) : "Speed" : : "Speed of the train from this stop onward, in units per second. " +
		"-1 makes the train jump straight to the next stop after waiting. With the movement time " +
		"flag set, this is instead the number of seconds the journey takes."
	wait(float) : "Wait Here" : "0" : "Seconds to pause at this stop before moving on."
	dmg(integer) : "Damage" : 0 : "Damage the train deals, applied when the damage flag is set."
	event(target_destination) : "Fire On Arrival" : : "Name of an entity to trigger when the " +
		"train reaches this stop."
	message(string) : "Message" : : "Text shown when the train reaches this stop."
	noise(string) : "Stop Sound" : : "Sound played when the train stops here, overriding the " +
		"train's own setting."
	noise1(string) : "Moving Sound" : : "Sound played while the train travels here, overriding " +
		"the train's own setting."
	spawnflags(flags) =
	[
		1 : "Rotation" : 0 : "The train turns at the rate set in the rotation speed key while " +
			"travelling to this stop."
		2 : "Angles" : 0 : "The train turns to the angles set in the angles key while travelling " +
			"to this stop. Cancels any continuous rotation."
		4 : "Stop" : 0 : "The train waits here until it is triggered again."
		8 : "No rotate" : 0 : "The train stops turning while it waits to be triggered."
		16 : "Damaging" : 0 : "The train hurts what it touches, using the damage key."
		32 : "Movement time" : 0 : "The speed key is read as the number of seconds the journey " +
			"takes rather than as a speed."
		64 : "Set target damage" : 0 : "The damage value is applied to everything the train " +
			"targets rather than to the train itself."
	]
]

@SolidClass base(Appearflags, Targetname, Bmodel) color(0 0 255) = func_movewall : "Invisible " +
	"collision for a rotating object. Give it the same name as the rotate_object it belongs to " +
	"and it will travel the same circular path without turning, so that players collide with " +
	"something where the rotating brushes appear to be.

Because it does not rotate, one movewall can only stand in for a small part of a rotating " +
	"shape. Cover the volume with several of them."
[
	target(target_destination) : "Axis" : : "Name of the info_rotate this wall orbits."
	dmg(integer) : "Touch Damage" : 0 : "Damage dealt to players who touch it, at most twice a " +
		"second. Requires the hurts flag."
	spawnflags(flags) =
	[
		1 : "Visible" : 0 : "The brushes are drawn instead of being invisible."
		2 : "Hurts" : 0 : "Touching the wall injures the player, using the damage key."
		4 : "Non-solid" : 0 : "The wall does not block movement, which leaves it useful only " +
			"with the visible flag set."
	]
]
