	delay(float) : "Trigger Delay" : : "Seconds to wait between this item being picked up and " +
		"its target firing."
]

@BaseClass base(Item) size(0 0 0, 32 32 56) color(80 0 200) = Ammo [
	spawnflags(flags) =
	[
		1 : "Large box" : 0 : "Holds twice the ammunition and uses the larger model."
	]
]

@PointClass base(Ammo) model({{
		spawnflags & 1 -> ":maps/b_shell1.bsp",
		":maps/b_shell0.bsp"
	}}) = item_shells : "Shells, for the shotgun and super shotgun. 20 in a small box, 40 in a " +
	"large one." []

@PointClass base(Ammo) model({{
		spawnflags & 1 -> ":maps/b_nail1.bsp",
		":maps/b_nail0.bsp"
	}}) = item_spikes : "Nails, for the nailgun and super nailgun. 25 in a small box, 50 in a " +
	"large one." []

@PointClass base(Ammo) model({{
		spawnflags & 1 -> ":maps/b_rock1.bsp",
		":maps/b_rock0.bsp"
	}}) = item_rockets : "Rockets, for the grenade launcher and rocket launcher. 5 in a small " +
	"box, 10 in a large one." []

@PointClass base(Ammo) model({{
		spawnflags & 1 -> ":maps/b_batt1.bsp",
		":maps/b_batt0.bsp"
	}}) = item_cells : "Cells, for the thunderbolt. 6 in a small box, 12 in a large one." []

@PointClass base(Ammo) = item_weapon : "Ammunition box from the original Quake entity set, kept " +
	"so that old maps still load. The flags choose which kind of ammunition it becomes, and it " +
	"turns itself into the matching item_shells, item_spikes or item_rockets on map load. An " +
	"entity with none of the ammunition flags set removes itself. New maps should place the " +
	"ammunition entities directly."
[
	spawnflags(flags) =
	[
		1 : "Shotgun ammunition" : 0 : "Becomes item_shells."
		2 : "Rocket ammunition" : 0 : "Becomes item_rockets. Ignored if the shotgun flag is set."
		4 : "Nail ammunition" : 0 : "Becomes item_spikes. Ignored if the shotgun flag is set."
		8 : "Large box" : 0 : "Carried over to the resulting ammunition item."
	]
]

@PointClass base(Item) size(0 0 0, 32 32 56) color(80 0 200)
	model({{
		spawnflags & 2 -> ":maps/b_bh100.bsp",
		spawnflags & 1 -> ":maps/b_bh10.bsp",
		":maps/b_bh25.bsp"
	}}) = item_health : "Health pickup. Restores 25 points by default, 15 as a rotten health " +
	"vial, or 100 as a megahealth that lifts the player above maximum health and then decays " +
	"back down."
[
	spawnflags(flags) =
	[
		1 : "Rotten" : 0 : "Restores 15 points instead of 25."
		2 : "Megahealth" : 0 : "Restores 100 points and allows health above 100, which then " +
			"decays back down. Takes precedence over the rotten flag."
	]
]

@PointClass base(Item) size(-16 -16 0, 16 16 56) color(80 0 200)
	model({ "path": ":progs/armor.mdl", "skin": 0 }) =
	item_armor1 : "Green armour. 100 points, absorbing 30 percent of incoming damage." []

@PointClass base(Item) size(-16 -16 0, 16 16 56) color(80 0 200)
	model({ "path": ":progs/armor.mdl", "skin": 1 }) =
	item_armor2 : "Yellow armour. 150 points, absorbing 60 percent of incoming damage." []

@PointClass base(Item) size(-16 -16 0, 16 16 56) color(80 0 200)
