			"Use this rather than building the door already open, so that its closed position is " +
			"where the brushwork is."
		4 : "Do not link" : 0 : "Stops this door being linked to touching doors."
		8 : "Gold key required" : 0 : "The door cannot be opened without the map's second key."
		16 : "Silver key required" : 0 : "The door cannot be opened without the map's first key."
		32 : "Toggle" : 0 : "Each trigger reverses the door instead of opening and closing it " +
			"automatically."
	]
]

@SolidClass base(Appearflags, Target, Targetname, Alpha, Bmodel) = func_door_secret : "Hidden " +
