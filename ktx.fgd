//=============================================================================
// Race mode
//
// A race route is a chain of entities: race_route_start names the route and
// points at the first race_route_marker, each marker points at the next, and
// the marker with no target is the finish line. Routes need at least two
// entities and may not loop back on themselves.
//
// KTX removes the whole route from the map once it has read it, and ignores
// routes entirely unless the server is running race mode. Routes are more
// often supplied in a separate .route file than built into the map.
//=============================================================================

@PointClass base(Appearflags, Target, Targetname, Race) size(-16 -16 -16, 16 16 16)
	color(255 128 0) =
	race_route_start : "RACE: starting line of a race route, and the entity that carries the " +
	"route's settings. Its target names the first marker on the route."
[
	race_route_name(string) : "Route Name" : : "RACE: short name of the route, shown to players " +
		"choosing between routes."
	race_route_description(string) : "Route Description" : : "RACE: longer description of the " +
		"route, shown alongside the name."
	race_route_timeout(integer) : "Time Limit" : : "RACE: seconds a racer has to finish before " +
		"the run is abandoned."
	race_route_weapon_mode(choices) : "Weapons" : 1 : "RACE: whether racers may use weapons " +
		"during a run." =
	[
		1 : "No weapons"
		2 : "Weapons allowed"
		3 : "Weapons allowed after two seconds"
	]
	race_route_falsestart_mode(choices) : "False Starts" : 1 : "RACE: whether a racer may move " +
		"before the start signal." =
	[
		1 : "Racer is held still until the start signal"
		2 : "Racer may move early, and the run counts from the signal"
	]
	race_route_start_yaw(float) : "Start Facing" : : "RACE: direction the racer faces at the " +
		"start line, in degrees."
	race_route_start_pitch(float) : "Start Pitch" : : "RACE: angle the racer looks up or down at " +
		"the start line, in degrees. Negative values look upward."
	size(string) : "Trigger Size" : "16 16 16" : "RACE: half the size of the start volume in " +
		"units, as 'x y z'."
]

@PointClass base(Appearflags, Target, Targetname, Race) size(-16 -16 -16, 16 16 16)
	color(255 128 0) =
	race_route_marker : "RACE: checkpoint on a race route. Its target names the next marker; the " +
	"marker that targets nothing is the finish line."
[
	size(string) : "Trigger Size" : "16 16 16" : "RACE: half the size of the checkpoint volume " +
		"in units, as 'x y z'."
]


//=============================================================================
// Monsters
//
// KTX carries the full single-player monster set, but removes monsters from a
// deathmatch server unless they are explicitly marked for it. A monster spawns
// in deathmatch only when all three skill flags are set and the deathmatch
// flag is clear, which is the spawnflags value 1792. This is how the bloodfest
// cooperative mode places its monsters.
//=============================================================================

@BaseClass base(Appearflags, Target, Targetname, Angle) color(220 0 0) size(-16 -16 -24, 16 16 40)
	model({ "path": ":progs/soldier.mdl" }) = Monster
[
	spawnflags(flags) =
	[
		1 : "Ambush" : 0 : "The monster ignores gunfire and other noises, and wakes only when it " +
			"sees a player."
		256 : "Not on easy" : 0 : "Removed on skill 0. All three skill flags must be set for a " +
			"monster to appear in deathmatch."
		512 : "Not on normal" : 0 : "Removed on skill 1. All three skill flags must be set for a " +
			"monster to appear in deathmatch."
		1024 : "Not on hard" : 0 : "Removed on skill 2 and above. All three skill flags must be " +
			"set for a monster to appear in deathmatch, giving spawnflags 1792."
		2048 : "Not in deathmatch" : 0 : "Removed in deathmatch even when the three skill flags " +
			"are set."
	]
]

@PointClass base(Monster) model({ "path": ":progs/soldier.mdl" }) =
	monster_army : "Grunt. Fires a shotgun at range." []

