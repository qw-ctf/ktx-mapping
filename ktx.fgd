[
	angle(integer) : "Jump Direction" : 0 : "Direction to throw monsters, in degrees."
	speed(integer) : "Forward Speed" : 200 : "How hard monsters are thrown forwards."
	height(integer) : "Jump Height" : 200 : "How hard monsters are thrown upwards."
]

@SolidClass base(Appearflags) = trigger_setskill : "Sets the server's skill level when a player " +
	"touches it, as used on the original start map. KTX removes this entity in deathmatch."
[
